k_user_service.authenticate.side_effect = lambda u, p: (\n        expected_output if u == \"username\" and p == \"password\" else None\n    )\n    result = perform_login(iter(input_data), mock_user_service)\n    \n    if expected_output:\n        assert isinstance(result, User)\n        assert result.username == input_data[0]\n    else:\n        assert result is None\n\n\n@pytest.mark.parametrize(\n    \"cheque_batch, expected_exceptions\",\n    [\n        # Test case: Valid cheques\n        (\n            [\n                BatchCheque(\"123\", \"001\", \"USD\", 200.0, \"sig1\"),\n                BatchCheque(\"124\", \"002\", \"EUR\", 300.0, \"sig2\"),\n            ],\n            [],\n        ),\n        # Test case: Invalid cheque with duplicate account\n        (\n            [\n                BatchCheque(\"123\", \"001\", \"USD\", 200.0, \"sig1\"),\n                BatchCheque(\"123\", \"001\", \"USD\", 200.0, \"sig1\"),\n            ],\n            [\"Duplicate cheque detected\"],\n        ),\n    ],\n)\ndef test_process_cheque_batch(mock_cheque_processor, cheque_batch, expected_exceptions):\n    \"\"\"\n    Tests cheque batch processing, ensuring that duplicate cheques are flagged as invalid.\n    \"\"\"\n    mock_cheque_processor.process.side_effect = lambda cheque: (\n        None if cheque_batch.count(cheque) == 1 else Exception(\"Duplicate cheque detected\")\n    )\n\n    exceptions = []\n\n    for cheque in cheque_batch:\n        try:\n            mock_cheque_processor.process(cheque)\n        except Exception as e:\n            exceptions.append(str(e))\n\n    assert exceptions == expected_exceptions\n\n\n@pytest.mark.parametrize(\"currency, amount, expected_conversion\", [\n    (\"USD\", 100, 85.0),  # USD to EUR\n    (\"EUR\", 200, 230.0),  # EUR to USD\n])\ndef test_display_currency_exchange_menu(mock_currency_exchange_service, currency, amount, expected_conversion):\n    \"\"\"\n    Validates the currency exchange menu, ensuring correct exchange rate calculations.\n    \"\"\"\n    mock_currency_exchange_service.get_rate.side_effect = lambda cur: (\n        0.85 if cur == \"USD\" else 1.15\n    )\n    rate = mock_currency_exchange_service.get_rate(currency)\n    converted_amount = amount * rate\n\n    assert converted_amount == expected_conversion\n    assert mock_currency_exchange_service.get_rate.call_count == 1\n\n\ndef test_handle_report_generation(mock_cheque_history_manager):\n    \"\"\"\n    Ensures report generation is invoked correctly.\n    \"\"\"\n    handle_report_generation(iter([\"dummy_option\"]), mock_cheque_history_manager)\n    mock_cheque_history_manager.generate_report.assert_called_once()\n\n\ndef test_handle_cheque_printing(mock_cheque_printing_service):\n    \"\"\"\n    Validates cheque printing functionality.\n    \"\"\"\n    handle_cheque_printing(iter([\"ChequeID\"]), mock_cheque_printing_service)\n    mock_cheque_printing_service.print_cheque.assert_called_once()\n\n\ndef test_handle_cheque_image_submission(mock_image_handler, mock_crypto_service, mock_clearinghouse_service, valid_user):\n    \"\"\"\n    Tests cheque image submission pipeline, including image processing, signing, and submission.\n    \"\"\"\n    mock_image_handler.process_image.return_value = \"encrypted_image_data\"\n    mock_crypto_service.sign_data.return_value = \"signed_image_data\"\n\n    handle_cheque_image_submission(\n        iter([\"some_input\"]),\n        mock_image_handler,\n        mock_crypto_service,\n        mock_clearinghouse_service,\n        valid_user\n    )\n\n    mock_image_handler.process_image.assert_called_once()\n    mock_crypto_service.sign_data.assert_called_once_with(\"encrypted_image_data\")\n    mock_clearinghouse_service.submit_image.assert_called_once_with(\"signed_image_data\")\n\n\n@pytest.mark.parametrize(\"account_number, cheque_number, currency, amount, signature\", [\n    (\"123456789\", \"987654321\", \"USD\", 1500.00, \"valid_signature\"),\n    (\"987654321\", \"123456789\", \"EUR\", 500.50, \"another_signature\"),\n])\ndef test_process_cheque(mock_cheque_processor, account_number, cheque_number, currency, amount, signature):\n    \"\"\"\n    Verifies processing of individual cheques with correct details.\n    \"\"\"\n    process_cheque(account_number, cheque_number, currency, amount, signature)\n    mock_cheque_processor.process_cheque.assert_called_once_with(account_number, cheque_number, currency, amount, signature)\n\n\n@pytest.mark.parametrize(\"username, password, expected_output\", [\n    (\"admin\", \"password\", User(username=\"admin\", REDACTED"password\", role=\"admin\")),\n    (\"user\", \"wrongpassword\", None),\n])\ndef test_authenticate(mock_user_service, username, password, expected_output):\n    \"\"\"\n    Ensures authenticate function validates credentials correctly.\n    \"\"\"\n    mock_user_service.authenticate.side_effect = lambda u, p: (\n        expected_output if u == \"admin\" and p == \"password\" else None\n    )\n    result = authenticate(username, password)\n\n    if expected_output:\n        assert result.username == expected_output.username\n    else:\n        assert result is None\n\n\n@pytest.mark.parametrize(\"external_failure, expected_retry_count\", [\n    (True, 3),  # Retry logic for external API failure\n    (False, 1),  # Single call on successful API request\n])\ndef test_currency_exchange_retry_logic(mock_currency_exchange_service, external_failure, expected_retry_count):\n    \"\"\"\n    Validates retry logic for currency exchange operations when external API fails.\n    \"\"\"\n    if external_failure:\n        mock_currency_exchange_service.get_rate.side_effect = RuntimeError(\"API fetch failure\")\n    else:\n        mock_currency_exchange_service.get_rate.return_value = CurrencyRate(rate=74.5, last_updated=datetime.now())\n\n    try:\n        display_currency_exchange_menu(iter([\"dummy_option\"]), mock_currency_exchange_service)\n    except Exception:\n        pass\n\n    assert mock_cur