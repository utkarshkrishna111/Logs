{"id": "chatcmpl-DkQIM1loC5YlqjCq57z7NrOkGbl2H", "choices": [{"finish_reason": "stop", "index": 0, "logprobs": null, "message": {"content": "```python\nimport pytest\nfrom decimal import Decimal\nfrom io import StringIO\nfrom contextlib import redirect_stdout\n\n\n# Mock definitions for LineItem and Invoice data structures (for testing purposes)\nclass LineItem:\n    def __init__(self, productCode, description, quantity, unitPrice):\n        self.productCode = productCode\n        self.description = description\n        self.quantity = quantity\n        self.unitPrice = Decimal(unitPrice)\n\n\nclass Invoice:\n    def __init__(self, invoiceNumber, customerId, items, discountPct, vatRate):\n        self.invoiceNumber = invoiceNumber\n        self.customerId = customerId\n        self.items = items\n        self.discountPct = Decimal(discountPct)\n        self.vatRate = Decimal(vatRate)\n\n\n# Mock `InvoiceCalculator` module functions\ndef calcSubtotal(invoice: Invoice) -> Decimal:\n    return sum(item.quantity * item.unitPrice for item in invoice.items)\n\n\ndef applyDiscount(subtotal: Decimal, discountPct: Decimal) -> Decimal:\n    if discountPct < 0 or discountPct > Decimal(\"50\"):  # Assume MAX_DISCOUNT is 50%\n        raise ValueError(\"Invalid Discount Percentage\")\n    return subtotal * (Decimal(\"1\") - discountPct / Decimal(\"100\"))\n\n\ndef calcVAT(amount: Decimal, vatRate: Decimal) -> Decimal:\n    return amount * (vatRate / Decimal(\"100\"))\n\n\ndef calcTotal(invoice: Invoice) -> Decimal:\n    if invoice.discountPct < 0 or invoice.discountPct > Decimal(\"50\"):  # Assume MAX_DISCOUNT is 50%\n        raise ValueError(\"Invalid Discount Percentage\")\n    subtotal = calcSubtotal(invoice)\n    discounted = applyDiscount(subtotal, invoice.discountPct)\n    vat = calcVAT(discounted, invoice.vatRate)\n    return discounted + vat\n\n\ndef printInvoiceSummary(invoice: Invoice):\n    subtotal = calcSubtotal(invoice)\n    discounted = applyDiscount(subtotal, invoice.discountPct)\n    vat = calcVAT(discounted, invoice.vatRate)\n    total = discounted + vat\n    print(f\"Invoice Summary:\")\n    print(f\"Invoice Number: {invoice.invoiceNumber}\")\n    print(f\"Customer ID: {invoice.customerId}\")\n    print(f\"Subtotal: ${subtotal:.2f}\")\n    print(f\"Discounted Total: ${discounted:.2f}\")\n    print(f\"VAT: ${vat:.2f}\")\n    print(f\"Grand Total: ${total:.2f}\")\n\n\n# Test cases with @pytest.mark.parametrize\n@pytest.mark.parametrize(\n    \"invoice, expected_subtotal\",\n    [\n        (\n            Invoice(\"INV123\", \"CUST1\", [LineItem(\"P1\", \"Product 1\", 2, \"10.00\")], \"0\", \"0\"),\n            Decimal(\"20.00\"),\n        ),  # Simple subtotal calculation with single item\n        (\n            Invoice(\"INV124\", \"CUST2\", [LineItem(\"P1\", \"Product 1\", 1, \"15.50\"), LineItem(\"P2\", \"Product 2\", 3, \"5.00\")], \"0\", \"0\"),\n            Decimal(\"30.50\"),\n        ),  # Subtotal for multiple line items\n    ],\n)\ndef test_calcSubtotal(invoice, expected_subtotal):\n    \"\"\"Test calcSubtotal computes the correct sum of (quantity \u00d7 unitPrice) across all items.\"\"\"\n    assert calcSubtotal(invoice) == expected_subtotal\n\n\n@pytest.mark.parametrize(\n    \"subtotal, discountPct, expected_total\",\n    [\n        (Decimal(\"100.00\"), Decimal(\"10\"), Decimal(\"90.00\")),  # 10% discount applied\n        (Decimal(\"200.00\"), Decimal(\"25\"), Decimal(\"150.00\")),  # 25% discount applied\n    ],\n)\ndef test_applyDiscount(subtotal, discountPct, expected_total):\n    \"\"\"Test applyDiscount applies the correct discount, and raises for invalid percentages.\"\"\"\n    assert applyDiscount(subtotal, discountPct) == expected_total\n\n    with pytest.raises(ValueError):\n        applyDiscount(subtotal, Decimal(\"-5\"))  # Negative discount\n\n    with pytest.raises(ValueError):\n        applyDiscount(subtotal, Decimal(\"60\"))  # Exceeding MAX_DISCOUNT\n\n\n@pytest.mark.parametrize(\n    \"amount, vatRate, expected_vat\",\n    [\n        (Decimal(\"100.00\"), Decimal(\"20\"), Decimal(\"20.00\")),  # 20% VAT\n        (Decimal(\"150.00\"), Decimal(\"10\"), Decimal(\"15.00\")),  # 10% VAT\n    ],\n)\ndef test_calcVAT(amount, vatRate, expected_vat):\n    \"\"\"Test calcVAT calculates the correct VAT amount based on the rate.\"\"\"\n    assert calcVAT(amount, vatRate) == expected_vat\n\n\n@pytest.mark.parametrize(\n    \"invoice, expected_total\",\n    [\n        (\n            Invoice(\"INV125\", \"CUST3\", [LineItem(\"P3\", \"Product 3\", 2, \"50.00\")], \"10\", \"20\"),\n            Decimal(\"108.00\"),\n        ),  # Subtotal = 100, discount = 90, VAT = 18, Total = 108\n    ],\n)\ndef test_calcTotal(invoice, expected_total):\n    \"\"\"Test calcTotal computes the correct total, including discounts and VAT.\"\"\"\n    assert calcTotal(invoice) == expected_total\n\n    with pytest.raises(ValueError):\n        inv = Invoice(\"INV126\", \"CUST4\", [LineItem(\"P4\", \"Product 4\", 1, \"100.00\")], \"-5\", \"10\")\n        calcTotal(inv)  # Invalid discountPct\n\n\n@pytest.mark.parametrize(\n    \"invoice, expected_output\",\n    [\n        (\n            Invoice(\"INV127\", \"CUST5\", [LineItem(\"P5\", \"Product 5\", 1, \"100.00\")], \"10\", \"20\"),\n            (\n                \"Invoice Summary:\\n\"\n                \"Invoice Number: INV127\\n\"\n                \"Customer ID: CUST5\\n\"\n                \"Subtotal: $100.00\\n\"\n                \"Discounted Total: $90.00\\n\"\n                \"VAT: $18.00\\n\"\n                \"Grand Total: $108.00\\n\"\n            ),\n        ),\n    ],\n)\ndef test_printInvoiceSummary(invoice, expected_output):\n    \"\"\"Test printInvoiceSummary correctly outputs the formatted invoice summary.\"\"\"\n    with StringIO() as buf, redirect_stdout(buf):\n        printInvoiceSummary(invoice)\n        output = buf.getvalue()\n    assert output == expected_output\n```", "refusal": null, "role": "assistant", "annotations": []